createOrReplace

	table dim_date

		column month
			dataType: string
			sourceColumn: month

		column year
			dataType: int64
			sourceColumn: year

		column quarter
			dataType: string
			sourceColumn: quarter

		column month_no
			dataType: int64
			sourceColumn: month_no

		column month_start
			dataType: string
			sourceColumn: month_start

		partition dim_date = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents("C:\Users\rajan\Documents\margin-recovery-case\data\dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					    Typed = Table.TransformColumnTypes(Promoted, {{"month", type text}, {"year", Int64.Type}, {"quarter", type text}, {"month_no", Int64.Type}, {"month_start", type text}}, "en-US")
					in
					    Typed

