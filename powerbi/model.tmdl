					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					    Typed = Table.TransformColumnTypes(Promoted, {{"order", Int64.Type}, {"driver", type text}, {"value_eur_m", type number}}, "en-US")
					in
					    Typed

