	table fact_fx

		column month
			dataType: string
			sourceColumn: month

		column sek_per_eur
			dataType: double
			sourceColumn: sek_per_eur

		partition fact_fx = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents("C:\Users\rajan\Documents\margin-recovery-case\data\fact_fx.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					    Typed = Table.TransformColumnTypes(Promoted, {{"month", type text}, {"sek_per_eur", type number}}, "en-US")
					in
					    Typed

	table fact_sales

		column month
			dataType: string
			sourceColumn: month

		column customer_id
			dataType: string
			sourceColumn: customer_id

		column segment_id
			dataType: string
			sourceColumn: segment_id

		column plant_id
			dataType: string
			sourceColumn: plant_id

		column currency
			dataType: string
			sourceColumn: currency

		column volume_t
			dataType: double
			sourceColumn: volume_t

		column net_sales_local
			dataType: double
			sourceColumn: net_sales_local

		column net_sales_eur
			dataType: double
			sourceColumn: net_sales_eur

		column orders
			dataType: int64
			sourceColumn: orders

		column deliveries
			dataType: int64
			sourceColumn: deliveries

		column freight_local
			dataType: double
			sourceColumn: freight_local

		column freight_eur
			dataType: double
			sourceColumn: freight_eur

		column order_handling_local
			dataType: double
			sourceColumn: order_handling_local

		column order_handling_eur
			dataType: double
			sourceColumn: order_handling_eur

		column Rate24 = LOOKUPVALUE ( fact_fx[sek_per_eur], fact_fx[month], "2024-" & RIGHT ( fact_sales[month], 2 ) )
			dataType: double

		column 'Sales CC' = IF ( fact_sales[currency] = "SEK", fact_sales[net_sales_local] / fact_sales[Rate24], fact_sales[net_sales_eur] )
			dataType: double

		column 'CTS CC' = IF ( fact_sales[currency] = "SEK", ( fact_sales[freight_local] + fact_sales[order_handling_local] ) / fact_sales[Rate24], fact_sales[freight_eur] + fact_sales[order_handling_eur] )
			dataType: double

		partition fact_sales = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents("C:\Users\rajan\Documents\margin-recovery-case\data\fact_sales.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					    Typed = Table.TransformColumnTypes(Promoted, {{"month", type text}, {"customer_id", type text}, {"segment_id", type text}, {"plant_id", type text}, {"currency", type text}, {"volume_t", type number}, {"net_sales_local", type number}, {"net_sales_eur", type number}, {"orders", Int64.Type}, {"deliveries", Int64.Type}, {"freight_local", type number}, {"freight_eur", type number}, {"order_handling_local", type number}, {"order_handling_eur", type number}}, "en-US")
					in
					    Typed

	table fact_plant_cost

		column month
			dataType: string
			sourceColumn: month

		column plant_id
			dataType: string
			sourceColumn: plant_id

		column currency
			dataType: string
			sourceColumn: currency

		column board_consumed_t
			dataType: double
			sourceColumn: board_consumed_t

		column fibre_cost_eur
			dataType: double
			sourceColumn: fibre_cost_eur

		column energy_mwh
			dataType: double
			sourceColumn: energy_mwh

		column energy_cost_local
			dataType: double
			sourceColumn: energy_cost_local

		column energy_cost_eur
			dataType: double
			sourceColumn: energy_cost_eur

		column other_variable_eur
			dataType: double
			sourceColumn: other_variable_eur

		column fixed_cost_local
			dataType: double
			sourceColumn: fixed_cost_local

		column fixed_cost_eur
			dataType: double
			sourceColumn: fixed_cost_eur

		column Rate24 = LOOKUPVALUE ( fact_fx[sek_per_eur], fact_fx[month], "2024-" & RIGHT ( fact_plant_cost[month], 2 ) )
			dataType: double

		column 'Fixed CC' = IF ( fact_plant_cost[currency] = "SEK", fact_plant_cost[fixed_cost_local] / fact_plant_cost[Rate24], fact_plant_cost[fixed_cost_eur] )
			dataType: double

		partition fact_plant_cost = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents("C:\Users\rajan\Documents\margin-recovery-case\data\fact_plant_cost.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					    Typed = Table.TransformColumnTypes(Promoted, {{"month", type text}, {"plant_id", type text}, {"currency", type text}, {"board_consumed_t", type number}, {"fibre_cost_eur", type number}, {"energy_mwh", type number}, {"energy_cost_local", type number}, {"energy_cost_eur", type number}, {"other_variable_eur", type number}, {"fixed_cost_local", type number}, {"fixed_cost_eur", type number}}, "en-US")
					in
					    Typed

