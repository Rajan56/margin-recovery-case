					    Source = Csv.Document(File.Contents("C:\Users\rajan\Documents\margin-recovery-case\powerbi\outputs\out_customer_profitability_2025.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					    Typed = Table.TransformColumnTypes(Promoted, {{"customer_id", type text}, {"tier", type text}, {"contract_type", type text}, {"plant_id", type text}, {"segment_id", type text}, {"vol", type number}, {"sales", type number}, {"contribution_before_cts", type number}, {"cost_to_serve", type number}, {"contribution_after_cts", type number}, {"fixed_alloc", type number}, {"ebitda", type number}, {"margin", type number}, {"cts_per_t", type number}, {"avg_order_t", type number}}, "en-US")
					in
					    Typed

	table energy_weekly

		column week_start
			dataType: dateTime
			sourceColumn: week_start

		column plant_id
			dataType: string
			sourceColumn: plant_id

		column production_t
			dataType: double
			sourceColumn: production_t

		column energy_mwh
			dataType: double
			sourceColumn: energy_mwh

		column intensity
			dataType: double
			sourceColumn: intensity

		column baseline
			dataType: double
			sourceColumn: baseline

		column dev
			dataType: double
			sourceColumn: dev

		column dev_4w
			dataType: double
			sourceColumn: dev_4w

		column breach
			dataType: boolean
			sourceColumn: breach

		partition energy_weekly = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents("C:\Users\rajan\Documents\margin-recovery-case\powerbi\outputs\out_energy_weekly.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					    Typed = Table.TransformColumnTypes(Promoted, {{"week_start", type date}, {"plant_id", type text}, {"production_t", type number}, {"energy_mwh", type number}, {"intensity", type number}, {"baseline", type number}, {"dev", type number}, {"dev_4w", type number}, {"breach", type logical}}, "en-US")
					in
					    Typed

	table initiatives

		column id
			dataType: string
			sourceColumn: id

		column name
			dataType: string
			sourceColumn: name

		column lever
			dataType: string
			sourceColumn: lever

		column value
			dataType: double
			sourceColumn: value

		column effort
			dataType: int64
			sourceColumn: effort

		column confidence
			dataType: string
			sourceColumn: confidence

		column time_to_value
			dataType: string
			sourceColumn: time_to_value

		column kpi
			dataType: string
			sourceColumn: kpi

		column how
			dataType: string
			sourceColumn: how

		column basis
			dataType: string
			sourceColumn: basis

		partition initiatives = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents("C:\Users\rajan\Documents\margin-recovery-case\powerbi\outputs\out_initiatives.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					    Typed = Table.TransformColumnTypes(Promoted, {{"id", type text}, {"name", type text}, {"lever", type text}, {"value", type number}, {"effort", Int64.Type}, {"confidence", type text}, {"time_to_value", type text}, {"kpi", type text}, {"how", type text}, {"basis", type text}}, "en-US")
					in
					    Typed

	table _Measures

		measure 'Volume t' = SUM ( fact_sales[volume_t] )
			formatString: #,0

		measure 'Net Sales' = SUM ( fact_sales[net_sales_eur] )
			formatString: \€#,0,,.0\m

		measure 'Net Sales CC' = SUM ( fact_sales[Sales CC] )
			formatString: \€#,0,,.0\m

		measure Freight = SUM ( fact_sales[freight_eur] )
			formatString: \€#,0,,.0\m

		measure 'Order Handling' = SUM ( fact_sales[order_handling_eur] )
			formatString: \€#,0,,.0\m

		measure Orders = SUM ( fact_sales[orders] )
			formatString: #,0

		measure 'Fibre Cost' = SUM ( fact_plant_cost[fibre_cost_eur] )
			formatString: \€#,0,,.0\m

		measure 'Energy Cost' = SUM ( fact_plant_cost[energy_cost_eur] )
			formatString: \€#,0,,.0\m

		measure 'Other Variable Cost' = SUM ( fact_plant_cost[other_variable_eur] )
			formatString: \€#,0,,.0\m

		measure 'Fixed Cost' = SUM ( fact_plant_cost[fixed_cost_eur] )
			formatString: \€#,0,,.0\m

		measure 'Energy MWh' = SUM ( fact_plant_cost[energy_mwh] )
			formatString: #,0

		measure 'Board Consumed t' = SUM ( fact_plant_cost[board_consumed_t] )
			formatString: #,0

		measure 'Cost to Serve' = [Freight] + [Order Handling]
			formatString: \€#,0,,.0\m

		measure EBITDA = [Net Sales] - [Fibre Cost] - [Energy Cost] - [Other Variable Cost] - [Cost to Serve] - [Fixed Cost]
			formatString: \€#,0,,.0\m

		measure 'EBITDA Margin %' = DIVIDE ( [EBITDA], [Net Sales] )
			formatString: 0.0%

		measure 'Price per t' = DIVIDE ( [Net Sales], [Volume t] )
			formatString: #,0

		measure 'Fibre per t' = DIVIDE ( [Fibre Cost], [Volume t] )
			formatString: #,0.0

		measure 'Energy per t' = DIVIDE ( [Energy Cost], [Volume t] )
			formatString: #,0.0

		measure 'Cost to Serve per t' = DIVIDE ( [Cost to Serve], [Volume t] )
			formatString: #,0.0

		measure 'Fixed per t' = DIVIDE ( [Fixed Cost], [Volume t] )
			formatString: #,0.0

		measure 'EBITDA per t' = DIVIDE ( [EBITDA], [Volume t] )
			formatString: #,0.0

		measure 'Board Usage t per t' = DIVIDE ( [Board Consumed t], [Volume t] )
			formatString: 0.000

		measure 'Energy MWh per t' = DIVIDE ( [Energy MWh], [Volume t] )
			formatString: 0.000

		measure 'Orders per 1000 t' = DIVIDE ( [Orders], [Volume t] ) * 1000
			formatString: #,0.0

		measure 'EBITDA FY2024' = CALCULATE ( [EBITDA], dim_date[year] = 2024 )
			formatString: \€#,0,,.0\m

		measure 'EBITDA FY2025' = CALCULATE ( [EBITDA], dim_date[year] = 2025 )
			formatString: \€#,0,,.0\m

		measure 'EBITDA Change' = [EBITDA FY2025] - [EBITDA FY2024]
			formatString: \€#,0,,.0\m

		measure 'Net Sales FY2025' = CALCULATE ( [Net Sales], dim_date[year] = 2025 )
			formatString: \€#,0,,.0\m

		measure 'EBITDA Margin FY2024' = CALCULATE ( [EBITDA Margin %], dim_date[year] = 2024 )
			formatString: 0.0%

		measure 'EBITDA Margin FY2025' = CALCULATE ( [EBITDA Margin %], dim_date[year] = 2025 )
			formatString: 0.0%

		measure 'Price Effect CC' = SUMX ( VALUES ( dim_customer[customer_id] ), VAR V25 = CALCULATE ( [Volume t], dim_date[year] = 2025 ) VAR V24 = CALCULATE ( [Volume t], dim_date[year] = 2024 ) VAR P25 = DIVIDE ( CALCULATE ( [Net Sales CC], dim_date[year] = 2025 ), V25 ) VAR P24 = DIVIDE ( CALCULATE ( [Net Sales CC], dim_date[year] = 2024 ), V24 ) RETURN V25 * ( P25 - P24 ) )
			formatString: \€#,0,,.0\m

		measure 'Cost to Serve Effect CC' = SUMX ( VALUES ( dim_customer[customer_id] ), VAR V25 = CALCULATE ( [Volume t], dim_date[year] = 2025 ) VAR V24 = CALCULATE ( [Volume t], dim_date[year] = 2024 ) VAR C25 = DIVIDE ( CALCULATE ( SUM ( fact_sales[CTS CC] ), dim_date[year] = 2025 ), V25 ) VAR C24 = DIVIDE ( CALCULATE ( SUM ( fact_sales[CTS CC] ), dim_date[year] = 2024 ), V24 ) RETURN - V25 * ( C25 - C24 ) )
			formatString: \€#,0,,.0\m

		measure 'Fibre Effect' = SUMX ( VALUES ( dim_plant[plant_id] ), VAR V25 = CALCULATE ( [Volume t], dim_date[year] = 2025 ) VAR R25 = CALCULATE ( [Fibre per t], dim_date[year] = 2025 ) VAR R24 = CALCULATE ( [Fibre per t], dim_date[year] = 2024 ) RETURN - V25 * ( R25 - R24 ) )
			formatString: \€#,0,,.0\m

		measure 'Fixed Cost Effect CC' = - ( CALCULATE ( SUM ( fact_plant_cost[Fixed CC] ), dim_date[year] = 2025 ) - CALCULATE ( [Fixed Cost], dim_date[year] = 2024 ) )
			formatString: \€#,0,,.0\m

		measure 'Bridge Value' = SUM ( bridge[value_eur_m] )
			formatString: #,0.00

		measure 'Customer EBITDA' = SUM ( customer_profit[ebitda] )
			formatString: \€#,0,,.0\m

		measure 'Customer EBITDA Margin' = DIVIDE ( SUM ( customer_profit[ebitda] ), SUM ( customer_profit[sales] ) )
			formatString: 0.0%

		measure 'Customer Cost to Serve per t' = DIVIDE ( SUM ( customer_profit[cost_to_serve] ), SUM ( customer_profit[vol] ) )
			formatString: #,0

		measure 'Loss-making Customers' = CALCULATE ( DISTINCTCOUNT ( customer_profit[customer_id] ), customer_profit[ebitda] < 0 )
			formatString: #,0

		measure Customers = DISTINCTCOUNT ( customer_profit[customer_id] )
			formatString: #,0

		measure 'Cumulative EBITDA %' = VAR ThisEbitda = SELECTEDVALUE ( customer_profit[ebitda] ) VAR Cum = CALCULATE ( SUM ( customer_profit[ebitda] ), FILTER ( ALL ( customer_profit ), customer_profit[ebitda] >= ThisEbitda ) ) RETURN DIVIDE ( Cum, CALCULATE ( SUM ( customer_profit[ebitda] ), ALL ( customer_profit ) ) )
			formatString: 0.0%

		measure 'Energy Intensity' = AVERAGE ( energy_weekly[intensity] )
			formatString: 0.000

		measure 'Energy Baseline' = AVERAGE ( energy_weekly[baseline] )
			formatString: 0.000

		measure 'Weeks in Alert' = CALCULATE ( COUNTROWS ( energy_weekly ), energy_weekly[dev_4w] > 0.06 )
			formatString: #,0

		measure 'Initiative Value' = SUM ( initiatives[value] )
			formatString: #,0.00

		column Dummy
			dataType: string
			isHidden
			sourceColumn: Dummy

		partition _Measures = m
			mode: import
			source =
					let
					    Source = #table(type table [Dummy = text], {})
					in
					    Source

	relationship rel_fact_sales_dim_date
		fromColumn: fact_sales.month
		toColumn: dim_date.month

	relationship rel_fact_sales_dim_customer
		fromColumn: fact_sales.customer_id
		toColumn: dim_customer.customer_id

	relationship rel_fact_sales_dim_segment
		fromColumn: fact_sales.segment_id
		toColumn: dim_segment.segment_id

	relationship rel_fact_sales_dim_plant
		fromColumn: fact_sales.plant_id
		toColumn: dim_plant.plant_id

	relationship rel_fact_plant_cost_dim_date
		fromColumn: fact_plant_cost.month
		toColumn: dim_date.month

	relationship rel_fact_plant_cost_dim_plant
		fromColumn: fact_plant_cost.plant_id
		toColumn: dim_plant.plant_id

	relationship rel_customer_profit_dim_customer
		fromColumn: customer_profit.customer_id
		toColumn: dim_customer.customer_id

	relationship rel_energy_weekly_dim_plant
		fromColumn: energy_weekly.plant_id
		toColumn: dim_plant.plant_id
